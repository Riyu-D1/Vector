#757 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#758 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#759 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#756,
  'distance_accuracy_value','confusion accuracy');
#760 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#761,#763);
#761 = ( REPRESENTATION_RELATIONSHIP('','',#32,#10) 
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#762) 
SHAPE_REPRESENTATION_RELATIONSHIP() );
#762 = ITEM_DEFINED_TRANSFORMATION('','',#11,#15);
#763 = PRODUCT_DEFINITION_SHAPE('Placement','Placement of an item',#764
  );
#764 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','=>[0:1:1:2]','',#5,#27,$);
#765 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#29));
ENDSEC;
